# Copy to .env and adjust. Compose reads these; deploy/stack.sh
# (or `make up`) also reads TUNNEL and the NGROK_* keys.

# How deploy/stack.sh exposes the stack to claude.ai / ChatGPT / Claude Desktop:
#   quick  Cloudflare quick tunnel: no account; a random https://*.trycloudflare.com
#          URL, new on every tunnel restart (BUNDLEMCP_PUBLIC_URL below is ignored)
#   ngrok  ngrok with a static domain: set NGROK_AUTHTOKEN and NGROK_DOMAIN
#   none   local only, at BUNDLEMCP_PUBLIC_URL
TUNNEL=quick
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=example.ngrok-free.app

# Maintainers only: seed.fleet.yaml also registers the private fleet (--profile fleet).
# BUNDLEMCP_SEED_FILE=seed.fleet.yaml

# The URL clients reach the gateway at; deploy/stack.sh sets it in the tunnel modes.
BUNDLEMCP_PUBLIC_URL=http://localhost:8000
BUNDLEMCP_OIDC_CLIENT_SECRET=dev-gateway-secret
# deploy/stack.sh (make up) generates these into deploy/.env before every start when they are
# missing or still hold the development values docker-compose.yml falls back to; run
# `deploy/stack.sh secrets` to generate them without starting. Plain `docker compose up` uses the
# published development values, which are safe only because every host port binds to 127.0.0.1.
# BUNDLEMCP_INITIAL_SERVICE_KEY=bmcp_sk_<43 random URL-safe characters>
# BUNDLEMCP_TOKEN_ENCRYPTION_KEYS=["<fernet-key>"]
# KEYCLOAK_ADMIN_PASSWORD=<the dev identity provider's admin console password>

# --- seo-gsc (Google Search Console MCP) -----------------------------------
# Google Cloud OAuth client (Web application) with Search Console scope.
# Authorized redirect URI must be: http://localhost:8001/google/callback
GSC_GOOGLE_CLIENT_ID=
GSC_GOOGLE_CLIENT_SECRET=
GSC_BASE_URL=http://localhost:8001
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GSC_TOKEN_ENCRYPTION_KEY=
# Generate: openssl rand -hex 32
GSC_SIGNING_KEY=

# --- dataforseo --------------------------------------------------------------
# Paid DataForSEO account; leave empty to boot the server without working calls.
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# --- optional image overrides -------------------------------------------------
# SEO_PSI_IMAGE=ghcr.io/mhoegger/seo-psi-mcp:latest
# SEO_GSC_IMAGE=ghcr.io/mhoegger/seo-gsc-mcp:latest
# HYPERFRAMES_IMAGE=ghcr.io/mhoegger/hyperframes-mcp:latest
# PSI_API_KEY=
