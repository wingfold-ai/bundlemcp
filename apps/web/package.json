{
  "name": "bundlemcp-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "openapi:export": "cd ../.. && uv run python -m bundlemcp.api.export_openapi > apps/web/openapi.json",
    "openapi:types": "openapi-typescript openapi.json -o types/api.d.ts",
    "test:ui": "playwright test",
    "test:ui:record": "PW_VIDEO=1 playwright test && node tests/stage-recordings.mjs",
    "test:map": "node tests/gen-testmap.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "nuxt": "^4.0.0",
    "openapi-fetch": "^0.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0"
  }
}
