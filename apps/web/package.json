{
  "name": "bundlemcp-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "openapi": "npm run openapi:export && npm run openapi:types",
    "openapi:export": "cd ../.. && uv run python -m bundlemcp.main.export_openapi > apps/web/openapi.json",
    "openapi:types": "openapi-typescript openapi.json -o types/api.d.ts --default-non-nullable=false",
    "test:ui": "playwright test",
    "test:ui:record": "PW_VIDEO=1 playwright test && node tests/stage-recordings.mjs",
    "test:map": "node tests/gen-testmap.mjs"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "nuxt": "^4.6.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "simple-git": "^4.0.2",
    "esbuild": "^0.28.2"
  }
}
