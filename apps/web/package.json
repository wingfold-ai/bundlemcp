{
  "name": "bundlemcp-web",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "openapi": "npm run openapi:export && npm run openapi:types",
    "openapi:export": "cd ../.. && uv run python -m bundlemcp.main.export_openapi > apps/web/openapi.json",
    "openapi:types": "openapi-typescript openapi.json -o types/api.d.ts --default-non-nullable=false",
    "test:ui": "playwright test",
    "test:ui:record": "PW_VIDEO=1 playwright test && node tests/stage-recordings.mjs",
    "test:map": "node tests/gen-testmap.mjs",
    "docs:screenshots": "playwright test --config playwright.docs.config.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "nuxt": "^4.6.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.141",
    "@playwright/test": "^1.55.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "simple-git": "^4.0.2",
    "esbuild": "^0.28.2",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
