// bundlemcp — LikeC4 model (single source for context/container views)
// Rendered via `npx likec4` (CLI or VS Code extension). See spec/62.

specification {
  // Palette of the documentation site: the wordmark teal for what bundlemcp
  // owns, a quiet slate for everything outside it
  color brand #2c7f86
  color brandDeep #1f5a5f
  color outside #4b5563

  element actor {
    style {
      shape person
      color brandDeep
    }
  }
  element system {
    style {
      color brand
    }
  }
  element container {
    style {
      color brand
    }
  }
  element component {
    style {
      color brand
    }
  }
  element database {
    style {
      shape storage
      color brandDeep
    }
  }
  element external {
    style {
      color outside
    }
  }

  relationship uses
  relationship mcp {
    technology 'MCP'
  }
}

model {
  admin = actor 'Administrator' {
    description 'Operates bundlemcp: registers servers, curates bundles, shapes endpoints'
  }

  mcpClient = external 'MCP Clients' {
    description 'claude.ai, ChatGPT, Copilot, scripts and other MCP consumers — handshake-era (initialize) and modern-era (2026-07-28) clients alike'
    style {
      shape browser
    }
  }

  idp = external 'OIDC Identity Provider' {
    description 'Keycloak, dex or any OIDC-compliant IdP. Authenticates humans; bundlemcp stores no passwords'
  }

  upstreams = external 'Upstream MCP Servers' {
    description 'Streamable HTTP MCP servers of either protocol era (containers or hosted); stdio servers via sidecar'
  }

  appLayer = external 'Application Layer' {
    description 'Optional consumer: billing via the metering hook, registrar via the management API'
  }

  bundlemcp = system 'bundlemcp' {
    description 'Self-hostable MCP bundling gateway'

    gateway = container 'Gateway' {
      description 'Serves bundle endpoints (full bidirectional MCP proxy, one dialect per protocol revision), OAuth 2.1 server, management REST API, middleware/metering'
      technology 'Python, FastAPI, FastMCP v4'

      // Clean-architecture layers (ADR-0033); dependencies point inward only
      api = component 'api' {
        description 'Delivery: /api/v1 controllers, OAuth 2.1 server + login, the Streamable-HTTP MCP edge (handlers, dialects, relay), jobs. Names contracts, never adapters'
        technology 'FastAPI; api/mcp also the MCP protocol library'
      }
      application = component 'application' {
        description 'Use cases (management, auth, oauth_server, upstream_oauth, delegation, discovery, serving, bootstrap), contracts (interfaces infrastructure fulfils), DTO schemas, settings model'
        technology 'Python, Pydantic; imports domain only'
      }
      domain = component 'domain' {
        description 'Entities by context, value objects, enums, policies and presentation rules; no I/O'
        technology 'Pydantic models (ADR-0034)'
      }
      infrastructure = component 'infrastructure' {
        description 'One adapter per port, grouped by technology: postgres, valkey, fastmcp, httpx, oidc, crypto, egress, metering, readiness, in-process, memory fakes'
        technology 'SQLAlchemy async, redis-py, FastMCP client, httpx, joserfc, cryptography'
      }
      main = component 'main' {
        description 'Composition root: create_app, CompositionRoot, AppContainer, CompositionOverrides. The only place adapters meet use cases'
        technology 'Python'
      }

      api -> application 'calls use cases; sees only contracts'
      infrastructure -> application 'implements contracts'
      application -> domain 'orchestrates entities and rules'
      main -> api 'mounts controllers'
      main -> infrastructure 'builds adapters'
      main -> application 'wires use cases'
    }

    web = container 'Admin Web App' {
      description 'Management UI: servers, bundles, endpoints, keys, audit, logs, inspector'
      technology 'Nuxt 4, Nuxt UI v4'
      style {
        shape browser
      }
    }

    pg = database 'Postgres' {
      description 'Durable state: config, users, tokens, tool cache, audit log'
      technology 'PostgreSQL, SQLModel/Alembic'
    }

    redis = database 'Redis' {
      description 'Live state: sessions, rate limits, live logs, cross-replica pub/sub'
      technology 'Redis'
    }
  }

  // context relationships
  admin -> web 'manages' 'HTTPS'
  mcpClient -[mcp]-> gateway 'calls, OAuth 2.1'
  gateway -[mcp]-> upstreams 'aggregates'
  upstreams -> gateway 'introspects' 'HTTPS'
  gateway -> idp 'login' 'OIDC'
  admin -> idp 'signs in'
  appLayer -> gateway 'registers' 'REST'
  gateway -> appLayer 'metering hook' 'Python hook -> REST'

  // container relationships
  web -> gateway 'management API' 'HTTPS /api/v1'
  gateway.infrastructure -> pg 'durable' 'SQLAlchemy async'
  gateway.infrastructure -> redis 'live' 'redis-py async'
}

views {
  view index of bundlemcp {
    title 'bundlemcp — System Context'
    // the system as one box: relationships to its containers roll up to it.
    // Labels are shortened here so the view stays legible at documentation
    // column width; the model keeps the full descriptions
    include
      bundlemcp with { description 'MCP bundling gateway' },
      admin with { description 'Registers servers, curates bundles, shapes endpoints' },
      mcpClient with { title 'MCP clients' description 'claude.ai, ChatGPT, scripts, agents' },
      upstreams with { title 'Upstream MCP servers' description 'Streamable HTTP, any protocol era' },
      idp with { title 'OIDC provider' description 'Keycloak or any OIDC issuer' },
      appLayer with { title 'Application layer' description 'Optional: billing, registrar' }
    style * {
      size xs
      textSize lg
    }
    autoLayout TopBottom
  }

  view containers of bundlemcp {
    title 'bundlemcp — Containers'
    include *, bundlemcp.*
    autoLayout TopBottom
  }

  view layers of bundlemcp.gateway {
    title 'Gateway — Clean-architecture layers'
    description 'Dependencies point inward: api and infrastructure know application, application knows domain (ADR-0033)'
    include *, bundlemcp.gateway.*
    autoLayout TopBottom
  }
}
